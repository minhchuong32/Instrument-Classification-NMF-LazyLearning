import json
import os
import numpy as np
import librosa
import soundfile as sf
import collections
from sklearn.model_selection import train_test_split
from tqdm import tqdm

INPUT_AUDIO_DIR = '/kaggle/input/nsynth-wav/nsynth-train-all/audio'
JSON_PATH = '/kaggle/input/nsynth-wav/nsynth-train-all/examples-train-original.json'
OUTPUT_DIR = '/kaggle/working/processed_nsynth'
TARGET_FAMILIES = ['bass', 'keyboard', 'guitar', 'flute'] # 4 lớp nhạc cụ 

# Tạo cấu trúc thư mục đầu ra
for sub in ['train', 'test_single', 'test_overlap']:
    os.makedirs(os.path.join(OUTPUT_DIR, sub), exist_ok=True)

# --- 2. Lọc và Chia Tập dữ liệu ---
with open(JSON_PATH, 'r') as f:
    metadata = json.load(f)

# Lọc ID file thuộc 4 nhóm nhạc cụ mục tiêu [cite: 44, 45]
filtered_ids = [k for k, v in metadata.items() if v['instrument_family_str'] in TARGET_FAMILIES]

# Chia Train/Test (80/20)
train_ids, test_ids = train_test_split(filtered_ids, test_size=0.2, random_state=42)

# Phân nhóm tập TEST theo family để phục vụ việc chọn nhạc cụ không trùng loại
test_groups = collections.defaultdict(list)
for fid in test_ids:
    fam = metadata[fid]['instrument_family_str']
    test_groups[fam].append(fid)

# --- 3. Hàm Xử lý: Loại bỏ Silent (Trim) ---
def process_and_save_single(file_list, target_subdir):
    """Loại bỏ khoảng lặng đầu/cuối và lưu file đơn lẻ[cite: 68, 79]."""
    for fid in tqdm(file_list, desc=f"Saving {target_subdir}"):
        in_p = os.path.join(INPUT_AUDIO_DIR, f"{fid}.wav")
        out_p = os.path.join(OUTPUT_DIR, target_subdir, f"{fid}.wav")
        try:
            # Load 16kHz [cite: 32]
            y, sr = librosa.load(in_p, sr=16000)
            # Loại bỏ silent (ngưỡng 30db để giữ lại transient/percussive) 
            y_trim, _ = librosa.effects.trim(y, top_db=30)
            sf.write(out_p, y_trim, sr)
        except Exception:
            continue

# --- 4. Hàm Tạo Testcase Chồng chéo (Không trùng loại) ---
def create_diverse_overlaps(groups, num_samples=50):
    """Tạo file mix từ 2-3 nhạc cụ thuộc các loại KHÁC NHAU."""
    families = list(groups.keys())
    overlap_log = []

    for i in tqdm(range(num_samples), desc="Creating Overlap Testcases"):
        # Chọn ngẫu nhiên số lượng nhạc cụ mix (2 hoặc 3)
        n_mix = np.random.choice([2, 3])
        
        # CHÍNH: Chọn các LOẠI nhạc cụ KHÁC NHAU (replace=False)
        picked_fams = np.random.choice(families, n_mix, replace=False)
        
        mixed_y = None
        sr = 16000
        component_ids = []

        for fam in picked_fams:
            # Chọn ngẫu nhiên 1 file ID từ loại nhạc cụ đó
            fid = np.random.choice(groups[fam])
            component_ids.append(fid)
            
            y, _ = librosa.load(os.path.join(INPUT_AUDIO_DIR, f"{fid}.wav"), sr=sr)
            y_trim, _ = librosa.effects.trim(y, top_db=30)
            
            # Cố định độ dài 4 giây (64000 samples) để cộng sóng âm [cite: 31]
            y_fixed = librosa.util.fix_length(y_trim, size=64000)
            
            if mixed_y is None:
                mixed_y = y_fixed
            else:
                mixed_y += y_fixed
        
        # Chuẩn hóa để tránh Distortion (méo tiếng) kỹ thuật [cite: 63, 64]
        mixed_y /= np.max(np.abs(mixed_y))
        
        # Tên file: overlap_STT_Loai1_Loai2.wav
        fname = f"overlap_{i:03d}_{'_'.join(picked_fams)}.wav"
        sf.write(os.path.join(OUTPUT_DIR, 'test_overlap', fname), mixed_y, sr)
        overlap_log.append({"file": fname, "components": component_ids})

    # Lưu metadata để phục vụ đánh giá (evaluation)
    with open(os.path.join(OUTPUT_DIR, 'overlap_log.json'), 'w') as f:
        json.dump(overlap_log, f, indent=4)

# --- 5. Thực thi ---
print("--- Bắt đầu tiền xử lý ---")
# Xử lý 500 file train và 100 file test đơn lẻ
process_and_save_single(train_ids[:500], 'train')
process_and_save_single(test_ids[:100], 'test_single')

# Tạo 50 mẫu testcase chồng chéo đa nhạc cụ
create_diverse_overlaps(test_groups, num_samples=50)

print(f"Hoàn thành! Dữ liệu lưu tại: {OUTPUT_DIR}")
